#source system files
if [[ -x /etc/profile ]]; then
    source "/etc/profile"
fi

# detech running shell
running_shell=$(ps -p $$ -o comm= | sed 's/^-//; s#.*/##')

# initial PATH
export PATH="${HOME}/.rc/.bin:${HOME}/.local/bin:${PATH}"

if [[ -d "${HOME}/.linuxbrew" ]]; then
  eval "$(~/.linuxbrew/bin/brew shellenv)"
fi

if [[ -d "/opt/homebrew" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

#Locales
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
export LANGUAGE=en_US.UTF-8

#Fix GPG ncurses passphrase
export GPG_TTY=$TTY

#User variables
export EDITOR="vim"
export VISUAL="vim"
export PAGER="less"
export GREP_COLOR="1;32"
export LESSCHARSET="UTF-8"

#Hardwire overrides
export ACKRC="${XDG_CONFIG_HOME:-$HOME/.config}/ack/ackrc"
export SCREENRC="${XDG_CONFIG_HOME:-$HOME/.config}/screen/screenrc"
export MAILCAPS="${XDG_CONFIG_HOME:-$HOME/.config}/mailcap/mailcap"

#'less' colors for colored manpages
export LESS_TERMCAP_mb=$'\E[01;31m'
export LESS_TERMCAP_md=$'\E[01;31m'
export LESS_TERMCAP_me=$'\E[0m'
export LESS_TERMCAP_se=$'\E[0m'
export LESS_TERMCAP_so=$'\E[01;44;33m'
export LESS_TERMCAP_ue=$'\E[0m'
export LESS_TERMCAP_us=$'\E[01;32m'

# local tty forced logout after 5 min
if [[ -z ${DISPLAY} && -z ${WAYLAND_DISPLAY} ]]; then
  case $(tty) in
    /dev/tty[1-9]|/dev/ttyv[0-9]) readonly TMOUT=300;;
  esac
fi

if [[ -f "${HOME}/.local/bin/mise" ]]; then
  eval "$(~/.local/bin/mise activate "${running_shell}")"
  eval "$(~/.local/bin/mise completion "${running_shell}")"
fi

# OSX doesn't support XDG natively, but majority of apps will happily follow
# Except rust apps using dirs crate, of course, because it's rust
if [[ ${OSTYPE} == darwin* ]]; then
  export XDG_CONFIG_HOME="${HOME}/.config"
  export XDG_CACHE_HOME="${HOME}/.cache"
  export XDG_DATA_HOME="${HOME}/.local/share"
  export XDG_STATE_HOME="${HOME}/.local/state"
fi

#kube-ps1 settings
KUBE_PS1_SYMBOL_ENABLE=false
KUBE_PS1_NS_ENABLE=false
KUBE_PS1_SUFFIX=") "
