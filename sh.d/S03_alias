# file for short aliases
alias j='jobs'
alias fixtty='stty sane && reset'
if ls -F --color=auto >&/dev/null; then
  alias ls='ls --color=auto -F'
else
  alias ls='ls -F'
fi
alias l.='ls -d .*'
alias ll='ls -lh'
alias la='ls -alh'
alias lr='ls -lR'
alias less='less -FRX'
alias cd..='cd ..'
alias ..='cd ..'
alias ...='cd ../..'
alias pg='ps aux | grep'
alias tcpdump='tcpdump -ttttnnn'
alias b='cd $OLDPWD'
alias recent='ls -lAt | head'
alias r='screen -DRA'
alias e='$EDITOR'
alias sdate='date +%d.%m.%Y'
alias iddqd='sudo -s'
alias ssh='ssh -C -X'
alias fuck='sudo !!'
alias watchip='ping -i 60 -a '
alias flushssh='pkill -TERM -u "$(id -u)" -x ssh'
alias myip='dig +short myip.opendns.com @resolver1.opendns.com'
alias omps='nono run --profile omp-lex -- omp'
alias codexs='nono run --profile codex-lex -- codex --sandbox danger-full-access --ask-for-approval on-request'
# vim-only VIMINIT - avoid conflicts with neovim
vim() {
  VIMINIT="set nocp | source ${XDG_CONFIG_HOME:-$HOME/.config}/vim/vimrc" command vim '$@'
}
# kitty-specific overrides
if [[ -n "${KITTY_INSTALLATION_DIR}" ]]; then
  alias ssh="kitten ssh $*"
fi