#!/usr/bin/env bash

# Simple shell script for symlinking all files from .rc dir to home directory
# Also upgrades, cleanups homebrew and similar stuff in single command
# Actually absurdly ugly, but hey, it works! Somehow.

# Trap ctrl-c
trap 'exit 130' INT

# colors
COLOR_RESET="$(tput sgr0)"
COLOR_GREEN="$(tput setaf 2)"
COLOR_RED="$(tput setaf 1)"
COLOR_CYAN="$(tput setaf 6)"
COLOR_YELLOW="$(tput setaf 3)"

# source config
# shellcheck disable=SC1091
source "${HOME}/.rc/envmgr.conf"

# Function to symlink dotfiles
# Checking if OS is Linux (GNU coreutils), if not, we assume OS uses BSD utils
symlink() {
  if [[ "${OSTYPE}" == "linux-gnu"* ]]; then
    ln -sfvn "${1}" "${2}"
  else
    ln -sfvh "${1}" "${2}"
  fi
}

# Symlink dotfiles and envmgr from ${HOME}/.rc to ~
install_env() {
  echo -e "${COLOR_CYAN}Deploying environment${COLOR_RESET}"
  cd "${HOME}/.rc" || exit
  echo -e "${COLOR_CYAN}Deploying dotfiles from $(pwd || true) to ${HOME}${COLOR_RESET}"
  mkdir -p "${HOME}/.config" "${HOME}/.local/share"
  case ${OSTYPE} in
    "linux-gnu"*) dotfiles=("${genenv[@]}" "${linuxenv[@]}") ;;
    "darwin"*) dotfiles=("${genenv[@]}" "${osxenv[@]}") ;;
    *) dotfiles=("${genenv[@]}") && echo "${COLOR_YELLOW}No OS detected - using generic${COLOR_RESET}" ;;
  esac
  for file in "${dotfiles[@]}"; do
   local src="${HOME}/.rc/.${file}"
   local dst="${HOME}/.${file}"
   if [[ ( -e "${dst}" || -L "${dst}" ) && ! -L "${dst}" ]]; then
     echo "${COLOR_RED}Existing item detected at ${dst}. Aborting${COLOR_RESET}"
     exit 1
   fi
   symlink "${src}" "${dst}"
  done
  symlink "${HOME}/.rc/envmgr" "${HOME}/.rc/.bin/envmgr"
  cd - >&/dev/null || exit 1
  echo -e "${COLOR_GREEN}Finished deploying dotfiles${COLOR_RESET}"
  if hash vim 2>/dev/null; then
    echo -e "${COLOR_CYAN}Installing vim plugins${COLOR_RESET}"
    vim +PlugInstall +qall
    echo -e "${COLOR_GREEN}Finished installing vim plugins${COLOR_RESET}"
  fi
}

# Install mise and tools (python, node, ruby, golang)
# TODO: detect last version automatically
# TODO: verify downloaded binary against shasum
install_devenv() {
  # install mise
  echo -e "${COLOR_CYAN}Installing mise${COLOR_RESET}"
  # detect if it's already installed, if yes, just do self-update
  if [[ -f ${HOME}/.local/bin/mise ]]; then
    mise self-update
  else
    # if not, download
    # detect os
    case ${OSTYPE} in
        "linux-gnu"*) mise_system="linux" ;;
        "darwin"*) mise_system="macos" ;;
        *) echo "${COLOR_RED}Unable to detect supported operating system${COLOR_RESET}" && exit 1 ;;
    esac
    # detect arch since naming is non-standard
    case $(uname -m) in
        "x86_64"*) mise_architecture="x64" ;;
        "arm64"*) mise_architecture="arm64" ;;
        "aarch64"*) mise_architecture="arm64" ;;
        *) echo "${COLOR_RED}Unable to detect supported architecture${COLOR_RESET}" && exit 1 ;;
    esac
    # ensure we have directory
    mkdir -p "${HOME}/.local/bin"
    # if we have jq available, parse latest version, otherwise use one from configs
    if hash jq 2>/dev/null; then
      mise_version=$(curl -s -H "Accept: application/vnd.github.v3+json" https://api.github.com/repos/jdx/mise/releases | jq -r '.[0].tag_name')
    fi
    mise_download_url=https://github.com/jdx/mise/releases/download/"${mise_version}"/mise-"${mise_version}"-"${mise_system}"-"${mise_architecture}"
    echo -e "${COLOR_CYAN}Downloading mise from ${mise_download_url}${COLOR_RESET}"
    curl -L "${mise_download_url}" > "${HOME}/.local/bin/mise"
    chmod +x "${HOME}/.local/bin/mise"
    # init mise, force bash because that's what we default
    eval "$("${HOME}"/.local/bin/mise activate bash || true)"
    # and bootstrap it
    mise install
  fi
  echo -e "${COLOR_GREEN}Finished installing mise${COLOR_RESET}"
}

# Installs homebrew on os x (global, script) and linux (manual, homedir)
# Also installs apps from ${HOME}/.rc/Brewfile
install_homebrew() {
  cd "${HOME}/.rc" || exit
  echo -e "${COLOR_CYAN}Installing homebrew and favourite packages${COLOR_RESET}"
  if hash brew 2>/dev/null; then
    echo "Brew is already installed!"
    else
      if [[ "${OSTYPE}" == "linux-gnu"* ]]; then
        git clone https://github.com/Homebrew/brew "${HOME}/.linuxbrew/Homebrew"
        mkdir "${HOME}/.linuxbrew/bin"
        ln -s "${HOME}/.linuxbrew/Homebrew/bin/brew" "${HOME}/.linuxbrew/bin"
        eval "$("${HOME}"/.linuxbrew/bin/brew shellenv || true)"
      elif [[ "${OSTYPE}" == "darwin"* ]]; then
        # TODO: Migrate to manual install
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh || true)"
        eval "$(/opt/homebrew/bin/brew shellenv || true)"
      fi
  fi
  brew bundle
}

# Nukes whole dotfiles setup
# TODO: Maybe use shred instead of rm?
env_nuke() {
  echo "${COLOR_CYAN}Cleaning up env${COLOR_RESET}"
  echo "${COLOR_CYAN}Removing dotfiles symlinks${COLOR_RESET}"
  for file in "${dotfiles[@]}"; do
    rm -vf "${HOME}/.${file}"
  done
  echo "${COLOR_CYAN}Cleaning up devenv${COLOR_RESET}"
  #for backwards compatibility
  rm -rf "${HOME}/.asdf"
  rm -rf "${HOME}/.local/bin/mise"
  rm -rf "${HOME}/.local/share/mise"
  rm -rf "${HOME}/.local/state/mise"
  echo "{COLOR_CYAN}Removing history${COLOR_RESET}"
  rm -vf "${HOME}/.zsh-history"
  rm -vf "${HOME}/.bash_history"
  echo "{COLOR_CYAN}Removing linuxbrew${COLOR_RESET}"
  rm -rf "${HOME}/.linuxbrew"
  echo "${COLOR_CYAN}Removing dotfiles directory${COLOR_RESET}"
  rm -rf "${HOME}/.rc"
  echo "${COLOR_GREEN}Uninstall complete${COLOR_RESET}"
}

# Checks for updates in env, homebrew, vim plugins and mac app store
env_housekeeper() {
if hash topgrade 2>/dev/null; then
  topgrade
else
  echo -e "${COLOR_CYAN}Started housekeeping${COLOR_RESET}"
  echo -e "${COLOR_CYAN}Updating dotfiles repo${COLOR_RESET}"
  git -C "${HOME}/.rc" pull
  echo -e "${COLOR_CYAN}Cleaning up outdated symlinks${COLOR_RESET}"
  find -L "${HOME}" -maxdepth 1 -type l -exec rm -i {} +
  if hash brew 2>/dev/null; then
    echo -e "${COLOR_CYAN}Updating and cleaning up homebrew${COLOR_RESET}"
    brew update
    brew upgrade -y
    brew cleanup
  fi
  # Update mise
  echo -e "${COLOR_CYAN}Updating mise and mise plugins${COLOR_RESET}"
  if hash mise 2>/dev/null; then
    mise self-update
    mise upgrade --bump
  fi
  if hash mas 2>/dev/null; then
    echo -e "${COLOR_CYAN}Updating mac app store apps${COLOR_RESET}"
    mas upgrade
  fi
  if hash vim 2>/dev/null; then
    echo -e "${COLOR_CYAN}Updating vim plugins${COLOR_RESET}"
    vim +PlugUpdate +PlugUpgrade +PlugClean +qall
  fi
  echo -e "${COLOR_GREEN}Housekeeping finished${COLOR_RESET}"
  if hash softwareupdate 2>/dev/null; then
    echo -e "${COLOR_CYAN}Updating OS X softare${COLOR_RESET}"
    softwareupdate -i -a
  fi
fi
}

compare_brewfile() {
  echo "${COLOR_CYAN}Checking for installed homebrew packages missing in Brewfile${COLOR_RESET}"
  local missing_formulae missing_casks

  missing_formulae=$(comm -23 <(brew list --installed-on-request | sort) \
                                <(brew bundle --file ~/.rc/Brewfile list --formula | sort))
  missing_casks=$(comm -23 <(brew list --cask | sort) \
                             <(brew bundle --file ~/.rc/Brewfile list --cask | sort))

  _check_brew_sync() {
    local name="$1" list="$2"
    if [[ -n "${list}" ]]; then
      echo "${COLOR_RED}${name} missing: ${list//$'\n'/ }${COLOR_RESET}"
    else
      echo "${COLOR_GREEN}${name} synced${COLOR_RESET}"
    fi
  }

  _check_brew_sync "Formulae" "${missing_formulae}"
  _check_brew_sync "Casks"    "${missing_casks}"
}

prepare_osx() {
  # wipe away default icons
  defaults write com.apple.dock persistent-apps -array && killall Dock
  # install xcode command line tools
  xcode-select --install
  # install rosetta
  softwareupdate --install-rosetta --agree-to-license
}

# Arguments parsing
case "${1}" in
  env) install_env ;;
  devenv) install_devenv ;;
  brew) install_homebrew ;;
  fullenv) install_env && install_devenv && install_homebrew ;;
  compare-brewfile) compare_brewfile ;;
  prepare-osx) prepare_osx ;;
  nuke) env_nuke ;;
  maid) env_housekeeper ;;
  *)
    echo "Command list:"
    echo "env - symlink dotfiles"
    echo "devenv - install mise with plugins"
    echo "brew - install homebrew and packages from bundle"
    echo "fullenv - env, devenv and brew combined"
    echo "nuke - remove (almost) everything installed by envmgr"
    echo "maid - upgrade stuff installed by envmgr"
    echo "prepare-osx - prepares fresh osx by writing some defaults"
    echo "compare-brewfile - checks if brewfile is out of sync, missing packages"
esac
